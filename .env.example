# Copy to .env for local Docker Compose only.
# Public URL where your Swetrix instance is reachable (no trailing slash).
BASE_URL=http://localhost:8080

# Secret key base for JWT auth tokens.
# Can be generated via: openssl rand -base64 48
SECRET_KEY_BASE=replace-with-openssl-rand-base64-48

DISABLE_REGISTRATION=true
DEBUG_MODE=false
IP_GEOLOCATION_DB_PATH=
CLIENT_IP_HEADER=x-forwarded-for

# Database credentials
# Can be generated via: openssl rand -hex 32
CLICKHOUSE_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_PASSWORD=

# Emails (optional). Leave SMTP_MOCK=true to log instead of sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
SMTP_MOCK=true

# OIDC (optional)
OIDC_ENABLED=false
OIDC_ONLY_AUTH=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROMPT=select_account
